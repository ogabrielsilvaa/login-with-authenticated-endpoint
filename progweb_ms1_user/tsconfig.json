{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    
    // 1. Dizemos ao TypeScript onde procurar as tipagens além do padrão
    "typeRoots": ["./node_modules/@types", "./src/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
  
  // 2. Forçamos o ts-node a ler nossos arquivos .d.ts locais (Esta é a chave!)
  "ts-node": {
    "files": true
  }
}